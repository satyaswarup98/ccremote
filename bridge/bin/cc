#!/bin/sh
# Runs Claude Code inside tmux so CC Remote can mirror the screen and type into it.
# Usage: cc [claude args...]   (detach with Ctrl-b d, reattach with: tmux attach -t <name>)
find_claude() {
  for c in "$HOME/.local/bin/claude" /opt/homebrew/bin/claude /usr/local/bin/claude; do
    [ -x "$c" ] && { echo "$c"; return; }
  done
  ls -d "$HOME"/.vscode/extensions/anthropic.claude-code-*/resources/native-binary/claude 2>/dev/null \
    | sort -V | tail -1
}
CLAUDE=$(find_claude)
[ -n "$CLAUDE" ] || { echo "cc: claude binary not found" >&2; exit 1; }
TMUX_BIN=$(command -v tmux || echo /opt/homebrew/bin/tmux)
if [ -n "$TMUX" ]; then
  exec "$CLAUDE" "$@"
fi
NAME="cc-$(basename "$PWD" | tr -c 'A-Za-z0-9_-' '_' | cut -c1-20)-$(date +%H%M%S)"
exec "$TMUX_BIN" new-session -s "$NAME" -c "$PWD" "$CLAUDE" "$@"
